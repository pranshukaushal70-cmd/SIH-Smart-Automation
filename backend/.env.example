# Copy to backend/.env to override defaults. No secrets are required.
VERI_MAX_UPLOAD_MB=10
VERI_MAX_PDF_PAGES=30
VERI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# auto | rapidocr | tesseract | none
VERI_OCR_ENGINE=auto
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
VERI_OCR_DPI=200
VERI_AUTO_SEED=1
# VERI_DATA_DIR=data
